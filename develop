#!/usr/bin/env python3
"""Select this checkout for one Codex thread's hook invocations."""
import argparse
import os
from pathlib import Path
from tempfile import TemporaryDirectory
from uuid import UUID


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--thread", type=UUID, default=os.getenv("CODEX_THREAD_ID"))
    parser.add_argument("--off", action="store_true")
    args = parser.parse_args()
    if not args.thread:
        parser.error("Run from the development chat or supply --thread ID.")
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    selection = home / "parallel-review-dev" / str(args.thread)
    if args.off:
        selection.unlink(missing_ok=True)
        selection.with_suffix(".last-event").unlink(missing_ok=True)
        print(f"{args.thread}: packaged hooks")
        return
    checkout = Path(__file__).resolve().parent
    selection.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with TemporaryDirectory(dir=selection.parent) as temp:
        link = Path(temp) / "checkout"
        link.symlink_to(checkout, target_is_directory=True)
        link.replace(selection)
    print(f"{args.thread}: {checkout}")


if __name__ == "__main__":
    main()
