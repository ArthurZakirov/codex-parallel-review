{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/python/dispatch.py\"",
            "statusMessage": "Recording changes for review",
            "timeout": 300
          }
        ],
        "matcher": "^(apply_patch|Bash|exec_command|write_stdin)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/python/dispatch.py\"",
            "statusMessage": "Checking for edits to review",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/python/dispatch.py\"",
            "statusMessage": "Observing Markdown edits",
            "timeout": 300
          }
        ],
        "matcher": "^(apply_patch|Bash|exec_command|write_stdin)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/python/dispatch.py\"",
            "statusMessage": "Recording writing request",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
